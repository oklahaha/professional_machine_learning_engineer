{
  "name": "pmle-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Study console: Google PMLE exam quiz, and DSAI flashcards + multiple choice",
  "scripts": {
    "extract": "node scripts/extract-questions.mjs",
    "cards": "node scripts/build-cards.mjs",
    "validate": "node scripts/validate-questions.mjs",
    "validate:cards": "node scripts/validate-cards.mjs",
    "mcq": "node scripts/build-mcq.mjs",
    "notes": "node scripts/build-notes.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning lib/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
